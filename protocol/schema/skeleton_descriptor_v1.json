{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuko.dev/motion-bridge/schema/skeleton_descriptor_v1.json",
  "title": "Motion Bridge Skeleton Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocolMajor",
    "protocolMinor",
    "sessionId",
    "requestId",
    "skeletonId",
    "skeletonHash",
    "coordinateSpace",
    "rootIndex",
    "joints"
  ],
  "properties": {
    "type": {
      "const": "skeleton_descriptor"
    },
    "protocolMajor": {
      "const": 1
    },
    "protocolMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "sessionId": {
      "$ref": "#/$defs/uint32"
    },
    "requestId": {
      "$ref": "#/$defs/uint32"
    },
    "skeletonId": {
      "type": "string",
      "minLength": 1
    },
    "skeletonHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinateSpace": {
      "const": "unity-left-handed-y-up-z-forward"
    },
    "rootIndex": {
      "const": 0
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/joint"
      }
    }
  },
  "$defs": {
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "humanBone",
        "parentIndex",
        "jointPath",
        "required",
        "restLocalPosition",
        "restLocalRotation",
        "restGlobalRotation"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "humanBone": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parentIndex": {
          "type": "integer",
          "minimum": -1,
          "maximum": 63
        },
        "jointPath": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "restLocalPosition": {
          "$ref": "#/$defs/vector3"
        },
        "restLocalRotation": {
          "$ref": "#/$defs/quaternion"
        },
        "restGlobalRotation": {
          "$ref": "#/$defs/quaternion"
        }
      }
    }
  }
}
